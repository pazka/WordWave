# wordwave — environment. Two uses, same keys:
#  - hosh-deploy (box standard): copy to /srv/wordwave/wordwave.env (chmod 600) for docker-compose.example.yml.
#  - legacy compose (docker-compose.yml): copy to .env next to it (only LOGIN, MDP, SECRET are read).
# Never commit the real file. The OWNER fills the secrets (never the agent); `hosh-deploy register`
# checks the names on the `# required:` line are non-empty (values are never printed).
# required: LOGIN MDP SECRET

# --- deployment (hosh-deploy) ---
# The only line hosh-deploy changes (one release tag per deploy). v1.4.0 = first release with /healthz.
WORDWAVE_IMAGE='ghcr.io/pazka/wordwave:v1.4.0'
WORDWAVE_BIND='127.0.0.1:9140'

# --- app secrets (same names and values as the legacy box .env) ---
# Admin login of the COM server (HTTP basic auth on the write routes, used by the admin UI).
LOGIN=
MDP=
# Flask SECRET_KEY (passed to the container as `secret`).
SECRET=
